# ==============================================================================
# .env.example — UrbanPulse
#
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — only this template file.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your values
#   source .env   (or let docker-compose pick it up automatically)
# ==============================================================================

# ─────────────────────────────────────────────────────────────
# AWS CONFIGURATION
# ─────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# Leave blank if using IAM role / instance profile (recommended for EC2/EMR)
# Only set for local development
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─────────────────────────────────────────────────────────────
# PROJECT IDENTITY
# ─────────────────────────────────────────────────────────────
PROJECT_NAME=urbanpulse
ENVIRONMENT=dev            # dev | staging | prod

# ─────────────────────────────────────────────────────────────
# S3 DATA LAKE
# These bucket names are auto-generated by Terraform and output
# after `terraform apply`. Fill in after first tf-apply.
# ─────────────────────────────────────────────────────────────
S3_LAKE_BUCKET=urbanpulse-lake-dev
S3_ARTIFACTS_BUCKET=urbanpulse-artifacts-dev

# S3 Prefixes (Medallion Architecture)
S3_RAW_PREFIX=raw            # Bronze zone
S3_STAGING_PREFIX=staging    # Silver zone
S3_CURATED_PREFIX=curated    # Gold zone

# ─────────────────────────────────────────────────────────────
# REDSHIFT DATA WAREHOUSE
# Fill in after `terraform apply` outputs the cluster endpoint
# ─────────────────────────────────────────────────────────────
REDSHIFT_HOST=urbanpulse-cluster-dev.xxxx.us-east-1.redshift.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DB=urbanpulse_dw
REDSHIFT_USER=admin
REDSHIFT_PASSWORD=ChangeMe123!   # Store real value in AWS Secrets Manager

# ─────────────────────────────────────────────────────────────
# DATA SOURCES
# ─────────────────────────────────────────────────────────────

# DataSF Taxi Trips API (no auth required for public data)
DATASF_BASE_URL=https://data.sfgov.org/resource/yitu-d5am.json
DATASF_APP_TOKEN=                # Optional: get free token at data.sfgov.org to avoid rate limits

# Open-Meteo Weather API (completely free, no key needed)
OPENMETEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive

# San Francisco coordinates for weather API
SF_LATITUDE=37.7749
SF_LONGITUDE=-122.4194

# ─────────────────────────────────────────────────────────────
# KAFKA / MSK
# ─────────────────────────────────────────────────────────────
# For local development (Docker), use localhost
# For AWS MSK, fill in after `terraform apply`
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TAXI_TOPIC=sf-taxi-events
KAFKA_WEATHER_TOPIC=sf-weather-events
KAFKA_CONSUMER_GROUP=urbanpulse-spark-consumer

# ─────────────────────────────────────────────────────────────
# AIRFLOW
# ─────────────────────────────────────────────────────────────
AIRFLOW__CORE__EXECUTOR=LocalExecutor     # LocalExecutor for dev, CeleryExecutor for prod
AIRFLOW__CORE__FERNET_KEY=               # Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__WEBSERVER__SECRET_KEY=          # Any random string for local dev
AIRFLOW_UID=50000

# Airflow DB (PostgreSQL backend — provided by docker-compose in dev)
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@localhost:5432/airflow

# ─────────────────────────────────────────────────────────────
# DBT
# ─────────────────────────────────────────────────────────────
DBT_PROFILES_DIR=./dbt
DBT_TARGET=dev       # dev | prod

# ─────────────────────────────────────────────────────────────
# GREAT EXPECTATIONS
# ─────────────────────────────────────────────────────────────
GE_DATA_CONTEXT_ROOT_DIR=./quality

# ─────────────────────────────────────────────────────────────
# ALERTS (Optional)
# ─────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=              # For Airflow failure alerts
ALERT_EMAIL=                    # Airflow email alerts recipient
